import uuid, json, asyncio
from httpx import ASGITransport, AsyncClient
from app.main import app

async def smoke_test():
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://test") as client:
        # Login
        from unittest.mock import patch
        with patch("app.routes.auth.verify_google_token") as mock:
            mock.return_value = {"email": "test@test.com", "name": "Test", "sub": "test-sub", "picture": None}
            resp = await client.post("/api/auth/google", json={"token": "tok"})
            data = resp.json()
            token = data["access_token"]

        # Create API endpoint goal
        from datetime import datetime, timedelta, timezone
        goal_data = {
            "title": "Smoke test API goal",
            "description": "Test API endpoint verification",
            "deadline": (datetime.now(timezone.utc) + timedelta(days=7)).isoformat(),
            "pledge_amount": 5000,
            "goal_type": "api_endpoint",
            "criteria": {
                "method": "GET",
                "url": "https://httpbin.org/get",
                "expected_status": 200,
            },
            "charity_id": "acct_charity123",
        }
        resp = await client.post("/api/goals", headers={"Authorization": f"Bearer {token}"}, json=goal_data)
        goal = resp.json()
        print(f"Created goal: {goal['id']} (status: {goal['status']})")

        # Activate goal
        resp = await client.put(f"/api/goals/{goal['id']}", headers={"Authorization": f"Bearer {token}"}, json={"status": "active"})
        print(f"Activated: {resp.status_code}")

        # Submit proof
        with patch("app.workers.api_check.run_api_verification_task.delay"):
            resp = await client.post(
                f"/api/goals/{goal['id']}/submit-proof",
                headers={"Authorization": f"Bearer {token}"},
                json={"url": "https://httpbin.org/get", "method": "GET"},
            )
            print(f"Submit proof: {resp.status_code}")
            if resp.status_code == 202:
                body = resp.json()
                print(f"  submission_id: {body['submission_id']}")
                print(f"  status: {body['verification_status']}")

        # Check verification status
        resp = await client.get(
            f"/api/goals/{goal['id']}/verification-status",
            headers={"Authorization": f"Bearer {token}"},
        )
        print(f"Verification status: {resp.status_code}")
        if resp.status_code == 200:
            body = resp.json()
            print(f"  submission_id: {body['submission_id']}")
            print(f"  status: {body['verification_status']}")

        # Test type mismatch
        resp = await client.post(
            f"/api/goals/{goal['id']}/submit-proof",
            headers={"Authorization": f"Bearer {token}"},
            json={"youtube_url": "https://youtube.com/watch?v=dQw4w9WgXcQ"},
        )
        print(f"Type mismatch (youtube -> api): {resp.status_code}")

        # Test missing url
        resp = await client.post(
            f"/api/goals/{goal['id']}/submit-proof",
            headers={"Authorization": f"Bearer {token}"},
            json={"method": "GET"},
        )
        print(f"Missing url: {resp.status_code}")

        print("\n✅ Smoke test complete!")

asyncio.run(smoke_test())
